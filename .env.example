PORT=3000

# RunningHub控制台生成的API Key。不要提交真实密钥到GitHub。
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# 公共Wan2.2 Animate V7应用ID。复制应用后请改成你自己的新ID。
WAN_WEBAPP_ID=2050318586283077633

# default=24G，plus=48G。建议先用default完成6-10秒测试。
WAN_INSTANCE_TYPE=default

# 可选：部署后的公网地址，用于OpenAPI文档，例如https://xxx.up.railway.app
PUBLIC_BASE_URL=

# 强烈建议设置。调用本服务时使用 Authorization: Bearer <token>
SERVICE_API_TOKEN=

# 上传限制（每个文件MB）与RunningHub请求超时（毫秒）
MAX_UPLOAD_MB=500
RUNNINGHUB_TIMEOUT_MS=180000

# 可选：允许的浏览器来源，多个用逗号分隔；留空表示允许所有来源。
CORS_ORIGINS=

# 节点映射二选一。首次部署可以留空，先调用/api/wan/mapping查看建议。
WAN_NODE_MAP_JSON=
WAN_NODE_MAP_FILE=
